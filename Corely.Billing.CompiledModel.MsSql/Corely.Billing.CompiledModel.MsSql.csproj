<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Corely Billing Compiled Model for SQL Server</Title>
    <Description>Corely.Billing's Entity Framework model built ahead of time for SQL Server, so an app on SQL Server skips building it on its first database call. Released with Corely.Billing at the same version.</Description>
    <PackageTags>Corely Billing EntityFramework CompiledModel SqlServer</PackageTags>
    <RepositoryUrl>https://github.com/ultrabstrong/Corely.Billing/tree/master/Corely.Billing.CompiledModel.MsSql</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ultrabstrong/Corely.Billing</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>6.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Corely.Billing\Corely.Billing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
