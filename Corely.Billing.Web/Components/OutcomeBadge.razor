@switch (Outcome)
{
    case ConsumptionOutcome.Settled:
        <span class="badge rounded-pill bg-success-subtle text-success-emphasis"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Settled</span>
        break;
    case ConsumptionOutcome.Released:
        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Released</span>
        break;
    default:
        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Reserved</span>
        break;
}

@code {
    [Parameter]
    public ConsumptionOutcome? Outcome { get; set; }
}
