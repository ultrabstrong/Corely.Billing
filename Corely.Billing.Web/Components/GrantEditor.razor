@inherits BillingComponentBase
<div class="cbw-editor">
    @if (_loading)
    {
        <div class="text-body-secondary" role="status">Loading grant…</div>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
    }
    else if (IsNew)
    {
        @ActionGate.Gate(GrantAction.Create, null, Form(true),
            @<div class="alert alert-secondary" role="status">You are not allowed to create grants.</div>)
    }
    else
    {
        @ActionGate.Gate(GrantAction.Update, GrantId, Form(true),
            @<text>
                <div class="alert alert-secondary" role="status">You can view this grant but not change it.</div>
                @Form(false)
            </text>)
        @if (_grant is { Kind: GrantKind.Capacity } capacity)
        {
            <h2 class="h5 mt-4">Registrations</h2>
            <RegistrationList AccountId="AccountId" Operation="capacity.Operation" GrantId="capacity.GrantId" />
        }
    }
</div>

@code {
    private RenderFragment Form(bool editable) =>
        @<form @onsubmit="SaveAsync" novalidate>
            @if (_grant is { Disabled: true })
            {
                <div class="alert alert-warning" role="status">This grant is disabled. Work already holding it finishes; nothing new can draw on it.</div>
            }
            <fieldset disabled="@(!editable || _saving)">
                <div class="mb-3">
                    <label for="cbw-operation" class="form-label">What to grant</label>
                    <select id="cbw-operation" class="form-select" @bind="OperationValue" disabled="@(!IsNew)">
                        @if (!IsNew && Definition is null)
                        {
                            <option value="@_operation.Value">@Vocabulary.DisplayName(_operation)</option>
                        }
                        @foreach (var kind in Vocabulary.ByKind())
                        {
                            <optgroup label="@kind.Key.GroupLabel()">
                                @foreach (var definition in kind)
                                {
                                    <option value="@definition.Operation.Value">@definition.DisplayName</option>
                                }
                            </optgroup>
                        }
                    </select>
                    @if (!IsNew)
                    {
                        <div class="form-text">A grant keeps what it grants. Create a new grant for something else.</div>
                    }
                </div>

                @if (Kind != GrantKind.Feature)
                {
                    <div class="mb-3">
                        <label for="cbw-quantity" class="form-label">@QuantityLabel</label>
                        <div class="input-group">
                            <input id="cbw-quantity" type="number" min="0" class="form-control" @bind="_quantity" disabled="@_unlimited" />
                            <span class="input-group-text" data-unit>@UnitPlural</span>
                        </div>
                        <div class="form-check mt-2">
                            <input id="cbw-unlimited" type="checkbox" class="form-check-input" @bind="_unlimited" />
                            <label for="cbw-unlimited" class="form-check-label">Unlimited</label>
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label for="cbw-from" class="form-label">Valid from (UTC)</label>
                        <input id="cbw-from" type="datetime-local" class="form-control" @bind="_validFromUtc" />
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="cbw-to" class="form-label">Valid to (UTC)</label>
                        @if (!_neverExpires)
                        {
                            <input id="cbw-to" type="datetime-local" class="form-control" @bind="_validToUtc" />
                        }
                        @if (CanNeverExpire)
                        {
                            <div class="form-check mt-2">
                                <input id="cbw-never-expires" type="checkbox" class="form-check-input" @bind="_neverExpires" />
                                <label for="cbw-never-expires" class="form-check-label">Never expires</label>
                            </div>
                        }
                    </div>
                </div>
            </fieldset>

            @if (_error is not null)
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }

            <div class="d-flex gap-2">
                @if (editable)
                {
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        @(IsNew ? "Create grant" : "Save changes")
                    </button>
                    @if (_grant is { } grant)
                    {
                        <button type="button" class="btn @(grant.Disabled ? "btn-outline-success" : "btn-outline-danger") cbw-toggle-disabled" disabled="@_saving" @onclick="ToggleDisabledAsync">
                            @(grant.Disabled ? "Enable grant" : "Disable grant")
                        </button>
                    }
                }
                @if (OnCancel.HasDelegate)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">@(editable ? "Cancel" : "Back")</button>
                }
            </div>
        </form>;
}
