@inherits BillingComponentBase
<div class="cbw-grants">
    @if (_grants.Count > 0 || _requests.Count > 0)
    {
        <div class="cbw-toolbar">
            @if (ShowExport && _grants.Count > 0)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_exporting" @onclick="ExportAsync">
                    <i class="bi bi-download me-1" aria-hidden="true"></i>CSV
                </button>
            }
            @if (CanRequestMore)
            {
                @ActionGate.Gate(GrantAction.Request, null,
                    @<a class="btn btn-outline-primary btn-sm" href="@RequestGrantHref"><i class="bi bi-envelope-plus me-1" aria-hidden="true"></i>Request a grant</a>)
            }
            @ActionGate.Gate(GrantAction.Create, null,
                @<a class="btn btn-primary btn-sm" href="@NewGrantHref"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New grant</a>)
        </div>
    }

    @if (_export is { IsError: true, Message: { } exportMessage })
    {
        <div class="alert alert-danger py-2" role="status">@exportMessage</div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_loading)
    {
        <div class="cbw-empty text-body-secondary" role="status">Loading grants…</div>
    }
    else if (_grants.Count == 0 && _requests.Count == 0 && _error is null)
    {
        <div class="cbw-empty">
            <p class="cbw-empty-title">No grants yet</p>
            @ActionGate.Gate(GrantAction.Create, null,
                @<text>
                    <p class="text-body-secondary">A grant is what this account holds of one operation between two dates: a balance to use, a capacity to register against, an amount added, or a feature.</p>
                    <a class="btn btn-primary btn-sm" href="@NewGrantHref">Create the first grant</a>
                </text>,
                @<p class="text-body-secondary">Grants given to this account will appear here.</p>)
            @ActionGate.Gate(GrantAction.Request, null,
                @<a class="btn btn-outline-primary btn-sm" href="@RequestGrantHref">Request a grant</a>)
        </div>
    }
    else if (_grants.Count > 0 || _requests.Count > 0)
    {
        <ul class="cbw-grant-rows" aria-label="Grants">
            <li class="cbw-grant-head" aria-hidden="true">
                <span>Grant</span>
                <span>State</span>
                <span>Valid</span>
                <span>Status</span>
                <span></span>
            </li>
            @foreach (var group in Groups)
            {
            <li class="cbw-grant-group" data-grant-kind="@group.Kind">@group.Kind.GroupLabel()</li>
            @foreach (var request in group.Requests)
            {
                <li class="cbw-grant-row cbw-request-row" data-grant-request-id="@request.GrantRequestId">
                    <div class="cbw-grant-name">
                        <span class="cbw-grant-allowance">@request.Asked(Vocabulary)</span>
                        <span class="cbw-grant-operation text-body-secondary">@Vocabulary.DisplayName(request.Operation)</span>
                    </div>
                    <div class="cbw-grant-balance cbw-request-note">
                        @if (request.Note is { } note)
                        {
                            <span>@note</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">No note</span>
                        }
                    </div>
                    <div class="cbw-grant-window">
                        <span>@request.RequestedText(Now)</span>
                    </div>
                    <div class="cbw-grant-status">
                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Requested</span>
                    </div>
                    <div class="cbw-grant-actions">
                        @ActionGate.Gate(GrantAction.Decide, request.GrantRequestId, Decision(request))
                        @if (request.RequestedByUserId is { } requester && requester == _userId)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Cancel request" @onclick="() => Open(DialogMode.Cancel, request)">
                                <i class="bi bi-x-circle" aria-hidden="true"></i><span class="cbw-action-label">Cancel request</span>
                            </button>
                        }
                    </div>
                </li>
            }
            @foreach (var grant in group.Grants)
            {
                var status = grant.Status(Now);
                <li class="cbw-grant-row" data-grant-id="@grant.GrantId">
                    <div class="cbw-grant-name">
                        <span class="cbw-grant-allowance">@grant.Headline(Vocabulary)</span>
                        <span class="cbw-grant-operation text-body-secondary">@Vocabulary.DisplayName(grant.Operation)</span>
                    </div>
                    <div class="cbw-grant-balance">
                        @if (grant.GetGrantType() == GrantType.Balance)
                        {
                            <BalanceMeter Balance="GrantBalance.For(grant)" UnitDisplayName="@grant.UnitName(Vocabulary)" />
                        }
                        else
                        {
                            <span class="cbw-grant-state" data-grant-type="@grant.GetGrantType()">@grant.StateText(Vocabulary, Now)</span>
                        }
                    </div>
                    <div class="cbw-grant-window">
                        <span>@grant.WindowText()</span>
                        <span class="cbw-grant-when text-body-secondary">@grant.WhenText(Now)</span>
                    </div>
                    <div class="cbw-grant-status">
                        <GrantStatusBadge Status="status" />
                    </div>
                    <div class="cbw-grant-actions">
                        @if (_confirmingDelete != grant.GrantId)
                        {
                            @ActionGate.Gate(GrantAction.Update, grant.GrantId,
                                @<a class="btn btn-sm btn-outline-primary" href="@GrantHref(grant.GrantId)" aria-label="Edit grant">
                                    <i class="bi bi-pencil" aria-hidden="true"></i><span class="cbw-action-label">Edit</span>
                                </a>,
                                @<a class="btn btn-sm btn-outline-secondary" href="@GrantHref(grant.GrantId)" aria-label="View grant">
                                    <i class="bi bi-eye" aria-hidden="true"></i><span class="cbw-action-label">View</span>
                                </a>)
                        }
                        @ActionGate.Gate(GrantAction.Delete, grant.GrantId,
                            @<text>
                                @if (_confirmingDelete == grant.GrantId)
                                {
                                    <span class="cbw-confirm-text">@grant.DeletePrompt(Vocabulary)</span>
                                    <button type="button" class="btn btn-sm btn-danger" disabled="@_deleting" @onclick="() => DeleteAsync(grant)">Delete</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_deleting" @onclick="CancelDelete">Keep</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Delete grant" @onclick="() => ConfirmDelete(grant)">
                                        <i class="bi bi-trash" aria-hidden="true"></i><span class="cbw-action-label">Delete</span>
                                    </button>
                                }
                            </text>)
                    </div>
                </li>
            }
            }
        </ul>
    }

    @if (_history.Count > 0)
    {
        <section class="cbw-request-history mt-4" aria-label="Decided grant requests">
            <h3 class="h6 text-body-secondary mb-2"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>Request history</h3>
            <ul class="list-group">
                @foreach (var past in _history)
                {
                    <li class="list-group-item cbw-history-row" data-grant-request-id="@past.GrantRequestId">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="badge rounded-pill @past.Status.HistoryBadgeClass()">@past.Status</span>
                            <span class="fw-semibold">@past.Asked(Vocabulary)</span>
                            <span class="text-body-secondary">@Vocabulary.DisplayName(past.Operation)</span>
                            @if (past.DecidedUtc is { } decided)
                            {
                                <span class="text-body-secondary ms-auto small">@decided.ToString("yyyy-MM-dd")</span>
                            }
                        </div>
                        @if (past.Note is { } asked)
                        {
                            <div class="small text-body-secondary mt-1">Asked: @asked</div>
                        }
                        @if (past.DecisionReason is { } why)
                        {
                            <div class="small mt-1">Reason: @why</div>
                        }
                    </li>
                }
            </ul>
        </section>
    }
</div>

@if (_dialog is { } dialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="cbw-dialog-title" @onkeydown="OnDialogKey">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="cbw-dialog-title">@dialog.Mode.Title()</h2>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_deciding" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Asked for</dt>
                        <dd class="col-sm-8">@dialog.Request.Asked(Vocabulary), @Vocabulary.DisplayName(dialog.Request.Operation)</dd>
                        <dt class="col-sm-4">Why</dt>
                        <dd class="col-sm-8">@(dialog.Request.Note ?? "No note")</dd>
                        <dt class="col-sm-4">Asked</dt>
                        <dd class="col-sm-8">@dialog.Request.RequestedText(Now)</dd>
                    </dl>
                    @if (dialog.Mode == DialogMode.Approve)
                    {
                        <p class="mb-0">Approving creates a grant for a year from today; you can change its window afterwards. The requester is told.</p>
                    }
                    else
                    {
                        <label class="form-label" for="cbw-dialog-reason">Reason, optional</label>
                        <textarea id="cbw-dialog-reason" class="form-control" rows="3" maxlength="500" @bind="_reason"></textarea>
                        <p class="form-text mb-0">@dialog.Mode.Consequence()</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_deciding" @onclick="CloseDialog">Back</button>
                    <button type="button" class="btn @dialog.Mode.ConfirmClass()" disabled="@_deciding" @onclick="ConfirmDialogAsync">
                        @if (_deciding)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        @dialog.Mode.ConfirmText()
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private RenderFragment Decision(GrantRequest request) =>
        @<text>
            <button type="button" class="btn btn-sm btn-outline-success" aria-label="Approve request" @onclick="() => Open(DialogMode.Approve, request)">
                <i class="bi bi-check-lg" aria-hidden="true"></i><span class="cbw-action-label">Approve</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Decline request" @onclick="() => Open(DialogMode.Decline, request)">
                <i class="bi bi-x-lg" aria-hidden="true"></i><span class="cbw-action-label">Decline</span>
            </button>
        </text>;
}
