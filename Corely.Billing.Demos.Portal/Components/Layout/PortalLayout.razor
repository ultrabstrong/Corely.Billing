@inherits LayoutComponentBase

<div class="portal bg-body text-body" data-bs-theme="@_theme">
    <nav class="navbar navbar-expand border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>Billing portal</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><NavLink class="nav-link" href="@BillingWebRoutes.GRANTS">Grants</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="@BillingWebRoutes.USAGE">Usage</NavLink></li>
            </ul>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleTheme"
                    aria-label="@(_theme == "dark" ? "Use light theme" : "Use dark theme")">
                <i class="bi @(_theme == "dark" ? "bi-sun" : "bi-moon-stars")" aria-hidden="true"></i>
            </button>
        </div>
    </nav>

    <main class="container py-4">
        @Body
    </main>
</div>

@code {
    private string _theme = "light";

    private void ToggleTheme() => _theme = _theme == "dark" ? "light" : "dark";
}
