<Router AppAssembly="typeof(Routes).Assembly" AdditionalAssemblies="[typeof(BillingWebRoutes).Assembly]">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(PortalLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(PortalLayout)">
            <p class="text-body-secondary">Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>
