@page "/"
@inject UsageSimulator Simulator

<PageTitle>Billing portal</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Demo account</h1>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary btn-sm" disabled="@_running" @onclick="() => SimulateAsync(s => s.GenerateTextAsync(Random.Shared.Next(1, 40_001)))">
            <i class="bi bi-chat-dots me-1" aria-hidden="true"></i>Simulate a chat reply
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_running" @onclick="() => SimulateAsync(s => s.EmbedAsync(Random.Shared.Next(1, 10_001)))">
            <i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>Simulate embeddings
        </button>
    </div>
</div>

@if (_message is not null)
{
    <div class="alert alert-info py-2" role="status">@_message</div>
}

<UsageDashboard @ref="_dashboard" AccountId="DemoUsage.AccountId" DefaultRange="90d" />

@code {
    private UsageDashboard? _dashboard;
    private string? _message;
    private bool _running;

    private async Task SimulateAsync(Func<UsageSimulator, Task<string>> request)
    {
        _running = true;
        _message = await request(Simulator);
        _running = false;
        if (_dashboard is not null)
            await _dashboard.RefreshAsync();
    }
}
