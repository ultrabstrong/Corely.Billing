@inherits LayoutComponentBase
@inject IBlazorUserContextAccessor UserContextAccessor

<nav class="navbar navbar-expand navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i>Acme Extraction</a>
        <AuthorizeView>
            <Authorized>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><NavLink class="nav-link" href="@BillingWebRoutes.GRANTS">Grants</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="@BillingWebRoutes.USAGE">Usage</NavLink></li>
                </ul>
                <span class="navbar-text me-3">@_username</span>
                <a class="btn btn-sm btn-outline-light" href="@AppRoutes.SignOut" data-enhance-nav="false">Sign out</a>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

<main class="container py-4">
    <AuthorizeView>
        <Authorized>@Body</Authorized>
        <NotAuthorized><RedirectToLogin /></NotAuthorized>
    </AuthorizeView>
</main>

@code {
    private string? _username;

    protected override async Task OnInitializedAsync()
    {
        var context = await UserContextAccessor.GetUserContextAsync();
        _username = context?.CurrentAccount is { } account
            ? $"{context.User?.Username} · {account.AccountName}"
            : context?.User?.Username;
    }
}
