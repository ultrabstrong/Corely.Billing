@inherits LayoutComponentBase
@inject IBlazorUserContextAccessor UserContextAccessor

<nav class="navbar navbar-expand navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="bi bi-stars me-2" aria-hidden="true"></i>Acme AI</a>
        <AuthorizeView>
            <Authorized>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><NavLink class="nav-link" href="@BillingWebRoutes.GRANTS">Grants</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="@BillingWebRoutes.USAGE">Usage</NavLink></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person me-1" aria-hidden="true"></i>@_username
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (_accountName is not null)
                            {
                                <li><h6 class="dropdown-header"><i class="bi bi-building me-2" aria-hidden="true"></i>@_accountName</h6></li>
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li><a class="dropdown-item" href="@AppRoutes.SignOut" data-enhance-nav="false"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</a></li>
                        </ul>
                    </li>
                </ul>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

<main class="container py-4">
    <AuthorizeView>
        <Authorized>@Body</Authorized>
        <NotAuthorized><RedirectToLogin /></NotAuthorized>
    </AuthorizeView>
</main>

@code {
    private string? _username;
    private string? _accountName;

    protected override async Task OnInitializedAsync()
    {
        var context = await UserContextAccessor.GetUserContextAsync();
        _username = context?.User?.Username;
        _accountName = context?.CurrentAccount?.AccountName;
    }
}
